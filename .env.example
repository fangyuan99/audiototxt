# Telegram Bot
ENV_BOT_TOKEN=your_telegram_bot_token
ENV_BOT_SECRET=replace_with_your_bot_password
TG_ALLOWED_USER_IDS=
TG_MAX_CONCURRENT_JOBS=1
TELEGRAM_EMBEDDED_ENABLED=false

# Global Gemini key pool (comma-separated). Telegram settings can replace/append keys.
GOOGLE_API_KEYS=
# Backward-compatible single-key fallbacks
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional Vertex AI JSON fallback
AUTH_MODE=gemini_api_key
VERTEX_SERVICE_ACCOUNT_FILE=
VERTEX_PROJECT=
VERTEX_LOCATION=global

# Telegram storage. Optional file overrides must remain inside BOT_DATA_DIR.
BOT_DATA_DIR=./data/telegram_bot
# BOT_STATE_FILE=./data/telegram_bot/state.json
# BOT_GLOBAL_CONFIG_FILE=./data/telegram_bot/global_config.json
# BOT_JOBS_FILE=./data/telegram_bot/jobs.json

# Media safety limits
MAX_MEDIA_BYTES=104857600
MEDIA_CONNECT_TIMEOUT_SECONDS=10
MEDIA_READ_TIMEOUT_SECONDS=60
MEDIA_TASK_TIMEOUT_SECONDS=1800
MEDIA_MAX_REDIRECTS=5

# Web UI is disabled unless explicitly enabled with an independent key.
WEB_ENABLED=false
WEB_ACCESS_KEY=
WEB_DATA_DIR=./data/web
